{
  "name": "botplus/wordpress-plugin",
  "description": "BotPlus AI Agents for WordPress & WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.8",
    "phpunit/phpunit": "^11.0",
    "brain/monkey": "dev-master",
    "wp-cli/wp-cli-bundle": "^2.7",
    "squizlabs/php_codesniffer": "^3.10",
    "phpstan/phpstan": "^1.11",
    "phpstan/extension-installer": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "BotPlus\\Plugin\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs": "phpcs --standard=WordPress includes/",
    "cs:fix": "phpcbf --standard=WordPress includes/",
    "stan": "phpstan analyse includes/"
  }
}