{
  "name": "@botplus/wordpress-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:admin && npm run build:widget && npm run build:loader",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:widget": "vite build --config vite.widget.config.js",
    "build:loader": "vite build --config vite.loader.config.js",
    "preview": "vite preview",
    "lint": "eslint assets/js --ext .js,.vue",
    "format": "prettier --write assets/js"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.1.0",
    "axios": "^1.7.0",
    "firebase": "^10.12.0",
    "@vueuse/core": "^10.11.0",
    "marked": "^16.2.1",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.3.0",
    "vite-plugin-singlefile": "^2.0.0",
    "unplugin-vue-router": "^0.10.0",
    "sass": "^1.77.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.0"
  }
}